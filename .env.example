ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# HARNESS_PROXY_PORT=8080
# HARNESS_TRANSPARENT_PROXY=false

# Host ports the claude container can reach via host.docker.internal:<port>
# Comma-separated list — only listed ports are forwarded; everything else is blocked.
# Example: postgres + rabbitmq + redis
# HOST_PORTS=5432,5672,6379
